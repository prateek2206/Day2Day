<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Service"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#222222" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Add details about your vehicle service"
            android:textSize="14sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/serviceDateEditText"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:hint="Service Date"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none" />

        <EditText
            android:id="@+id/serviceCenterEditText"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:hint="Service Center / Mechanic"
            android:inputType="text" />

        <EditText
            android:id="@+id/serviceDetailsEditText"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="15dp"
            android:gravity="top"
            android:hint="Service Details"
            android:inputType="textMultiLine" />

        <Button
            android:id="@+id/selectServiceFileButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:text="Select Bill / Receipt"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/selectedServiceFileText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No file selected"
            android:textSize="14sp"
            android:textColor="#666666" />

        <Button
            android:id="@+id/saveServiceButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:text="Save Service"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>