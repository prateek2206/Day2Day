<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Vehicle"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#222222" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Enter your vehicle details."
            android:textSize="14sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/vehicleName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:hint="Vehicle Name / Model"
            android:inputType="text"
            android:padding="15dp" />

        <EditText
            android:id="@+id/vehicleNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Vehicle Number"
            android:inputType="text"
            android:padding="15dp" />

        <EditText
            android:id="@+id/serviceDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Last Service Date"
            android:focusable="false"
            android:clickable="true"
            android:padding="15dp" />

        <EditText
            android:id="@+id/insuranceExpiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Insurance Expiry Date"
            android:focusable="false"
            android:clickable="true"
            android:padding="15dp" />

        <EditText
            android:id="@+id/pucExpiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="PUC Expiry Date"
            android:focusable="false"
            android:clickable="true"
            android:padding="15dp" />

        <!-- Fuel Expense -->
        <EditText
            android:id="@+id/fuelExpense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Fuel Expense"
            android:inputType="numberDecimal"
            android:padding="15dp" />

        <Button
            android:id="@+id/saveVehicleButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:text="Save Vehicle"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>