<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Medical Condition"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#222222" />

        <TextView
            android:id="@+id/personNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Person"
            android:textSize="15sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/conditionName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:hint="Medical Condition / Disease"
            android:inputType="text"
            android:padding="15dp" />

        <EditText
            android:id="@+id/conditionNotes"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            android:hint="Notes (Optional)"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:padding="15dp" />

        <EditText
            android:id="@+id/nextAppointment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Next Appointment (Optional)"
            android:focusable="false"
            android:clickable="true"
            android:padding="15dp" />

        <Button
            android:id="@+id/saveConditionButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:text="Save Medical Condition"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>